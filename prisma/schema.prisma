generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id       Int        @id @default(autoincrement())
  name     String
  email    String
  phone    String?
  message  String
  status   LeadStatus @default(NEW)
  budget   String?
  project  String?
  timeline String?
  notes    String?
  score    Int        @default(0)
  source   String?
  priority Int        @default(0)

  // CRM fields
  companyName     String?
  industry        String?
  assignedTo      String?
  lastContactedAt DateTime?
  archivedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments Assessment[]

  @@index([email])
  @@index([status, createdAt])
  @@index([source])
}

model Assessment {
  id        String @id @default(cuid())
  sessionId String @unique

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  status              AssessmentStatus    @default(IN_PROGRESS)
  qualificationStatus QualificationStatus @default(NEEDS_DISCOVERY)
  qualificationScore  Int                 @default(0)
  assessmentType      String              @default("BUSINESS_OS")

  contactName  String?
  contactEmail String?

  funnelState AssessmentFunnelState @default(DISCOVERY)

  assessmentEmailSentAt DateTime?
  bookingLinkSentAt     DateTime?

  businessName        String?
  industry            String?
  businessModel       String?
  teamSize            String?
  decisionMaker       String?
  investmentReadiness String?

  bookings Booking[]

  businessProfile       Json?
  operationalChallenges Json?
  currentTools          Json?
  requirements          Json?
  conversation          Json?
  assessmentSummary     String?

  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  leadFunnelSession LeadFunnelSession?

  @@index([leadId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  LOST
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum QualificationStatus {
  NEEDS_DISCOVERY
  QUALIFIED
  NEEDS_REVIEW
  NOT_READY
  NOT_A_FIT
}

enum AssessmentFunnelState {
  DISCOVERY
  QUALIFIED
  AWAITING_CONSENT
  COLLECTING_NAME
  COLLECTING_EMAIL
  BOOKING_LINK_SENT
  DECLINED
  CLOSED
}

model Booking {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)

  attendeeName  String
  attendeeEmail String

  startAt  DateTime
  endAt    DateTime
  timeZone String

  status BookingStatus @default(BOOKED)

  googleEventId String? @unique
  meetUrl       String?

  emailDeliveries EmailDelivery[]

  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assessmentId])
  @@index([startAt, endAt])
  @@index([status, startAt])
}

enum BookingStatus {
  BOOKED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

model GoogleCalendarConnection {
  id                    String  @id @default("primary")
  calendarId            String  @default("primary")
  encryptedRefreshToken String
  connectedEmail        String?
  connected             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailDelivery {
  id     String              @id @default(cuid())
  key    String              @unique
  type   EmailDeliveryType
  status EmailDeliveryStatus @default(PENDING)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  recipient         String?
  subject           String?
  html              String?
  text              String?
  scheduledFor      DateTime
  sentAt            DateTime?
  providerMessageId String?

  attempts  Int     @default(0)
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
  @@index([bookingId, type])
}

model LeadFunnelSession {
  id        String      @id @default(cuid())
  sessionId String      @unique
  stage     FunnelStage @default(QUALIFICATION_STARTED)

  contactName         String?
  contactEmail        String?
  businessName        String?
  industry            String?
  teamSize            String?
  investmentReadiness String?

  followUpConsent Boolean   @default(false)
  consentAt       DateTime?
  unsubscribedAt  DateTime?

  assessmentId String?     @unique
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  lastActivityAt DateTime  @default(now())
  completedAt    DateTime?

  followUps LeadFollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage, lastActivityAt])
  @@index([contactEmail])
}

model LeadFollowUp {
  id              String @id @default(cuid())
  funnelSessionId String

  funnelSession LeadFunnelSession @relation(fields: [funnelSessionId], references: [id], onDelete: Cascade)

  sequence          FollowUpSequence
  step              Int
  status            FollowUpStatus   @default(SCHEDULED)
  scheduledFor      DateTime
  sentAt            DateTime?
  providerMessageId String?
  error             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([funnelSessionId, sequence, step])
  @@index([status, scheduledFor])
}

enum FunnelStage {
  QUALIFICATION_STARTED
  QUALIFICATION_COMPLETED
  ASSESSMENT_STARTED
  ASSESSMENT_ABANDONED
  ASSESSMENT_COMPLETED
  BOOKED
}

enum FollowUpSequence {
  QUALIFICATION_ABANDONMENT
  ASSESSMENT_ABANDONMENT
}

enum FollowUpStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum EmailDeliveryType {
  BOOKING_REMINDER
  POST_MEETING_FOLLOWUP
  BOOKING_CONFIRMATION
  ADMIN_BOOKING_NOTIFICATION
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}
